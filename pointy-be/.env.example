# Copy this file to .env for local runs. On Render, set these in the service's
# Environment tab instead. .env is ignored by git.

# Postgres. Without it the server keeps everything in memory only.
DATABASE_URL=postgres://postgres@localhost:5433/pointy

# PayPal checkout (adding money). "mock" approves every payment at once and is
# only for trying the app. Use "sandbox" with a US sandbox business account:
# PayPal does not move money between Indian accounts.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_CURRENCY=USD
# Rupees per US dollar used to convert amounts for PayPal.
POINTY_INR_PER_UNIT=85
# Only needed once a webhook is registered for /webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Language-model features: trip summaries and the deposit assistant. Without
# a key they fall back to rule-based text. Model defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
POINTY_AI_MODEL=

# Where phones and PayPal reach this server. Render sets RENDER_EXTERNAL_URL
# for you, so this is only needed elsewhere.
PUBLIC_URL=
