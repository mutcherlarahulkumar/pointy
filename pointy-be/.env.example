# Copy this file to .env and fill it in. .env is ignored by git.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Email of the sandbox BUSINESS account that owns the app (used on invoices)
PAYPAL_INVOICER_EMAIL=
# Only needed once a webhook is registered for /webhooks/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
POINTY_INR_PER_UNIT=85
